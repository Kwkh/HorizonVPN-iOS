+// Snapshot-only descriptors avoid creating adapters or starting health checks.
+type IOSPolicyNode struct {
+	Name string `json:"name"`
+	Type string `json:"type"`
+}
+type IOSPolicyProvider struct {
+	Compatible bool            `json:"compatible"`
+	Nodes      []IOSPolicyNode `json:"nodes"`
+}
+
+var iosPolicyTypes = map[string]C.AdapterType{"ss": C.Shadowsocks, "hysteria2": C.Hysteria2, "hy2": C.Hysteria2, "tuic": C.Tuic, "vmess": C.Vmess, "vless": C.Vless, "trojan": C.Trojan, "select": C.Selector, "url-test": C.URLTest, "fallback": C.Fallback, "DIRECT": C.Direct, "REJECT": C.Reject, "REJECT-DROP": C.RejectDrop}
+
+type iosPolicyProxy struct {
+	C.Proxy
+	node IOSPolicyNode
+}
+
+func (p iosPolicyProxy) Name() string        { return p.node.Name }
+func (p iosPolicyProxy) Type() C.AdapterType { return iosPolicyTypes[p.node.Type] }
+
+type iosPolicyProvider struct {
+	P.ProxyProvider
+	data IOSPolicyProvider
+}
+
+func (p iosPolicyProvider) Version() uint32 { return 1 }
+func (p iosPolicyProvider) VehicleType() P.VehicleType {
+	if p.data.Compatible {
+		return P.Compatible
+	}
+	return P.Inline
+}
+func (p iosPolicyProvider) Proxies() []C.Proxy {
+	r := []C.Proxy{}
+	for _, n := range p.data.Nodes {
+		r = append(r, iosPolicyProxy{node: n})
+	}
+	return r
+}
