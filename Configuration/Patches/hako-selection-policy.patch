+// ResolveMappingsForIOS materializes an immutable iOS provider snapshot. Ordering,
+// raw-type exclusion, pre-override name matching and mutation order deliberately
+// follow NewProxiesParser. Overrides use the very same Apply implementation.
+// No adapter or provider is started here; the caller validates effective nodes.
+func ResolveMappingsForIOS(options map[string]any, nodes []map[string]any) ([]map[string]any, error) {
+	fail := fmt.Errorf("invalid provider policy")
+	if len(nodes) == 0 || len(nodes) > 512 {
+		return nil, fail
+	}
+	var schema struct {
+		Filter        string         `provider:"filter,omitempty"`
+		ExcludeFilter string         `provider:"exclude-filter,omitempty"`
+		ExcludeType   string         `provider:"exclude-type,omitempty"`
+		Override      overrideSchema `provider:"override,omitempty"`
+	}
+	if err := structure.NewDecoder(structure.Option{TagName: "provider"}).Decode(options, &schema); err != nil {
+		return nil, fail
+	}
+	deadline := time.Now().Add(2 * time.Second)
+	compile := func(text string) ([]*regexp2.Regexp, error) {
+		if len(text) > 2048 || len(strings.Split(text, "`")) > 16 {
+			return nil, fail
+		}
+		regs := []*regexp2.Regexp{}
+		for _, part := range strings.Split(text, "`") {
+			r, e := regexp2.Compile(part, regexp2.None)
+			if e != nil {
+				return nil, fail
+			}
+			r.MatchTimeout = 10 * time.Millisecond
+			regs = append(regs, r)
+		}
+		return regs, nil
+	}
+	filters, err := compile(schema.Filter)
+	if err != nil {
+		return nil, fail
+	}
+	excludes, err := compile(schema.ExcludeFilter)
+	if err != nil {
+		return nil, fail
+	}
+	if len(schema.Override.ProxyName) > 16 {
+		return nil, fail
+	}
+	for _, p := range schema.Override.ProxyName {
+		if p.Pattern == nil {
+			return nil, fail
+		}
+		p.Pattern.MatchTimeout = 10 * time.Millisecond
+	}
+	match := func(r *regexp2.Regexp, name string) (bool, error) {
+		if time.Now().After(deadline) || len(name) > 1024 {
+			return false, fail
+		}
+		return r.MatchString(name)
+	}
+	result := []map[string]any{}
+	seen := map[string]bool{}
+	for _, filter := range filters {
+	LOOP:
+		for _, node := range nodes {
+			name, ok := node["name"].(string)
+			if !ok {
+				return nil, fail
+			}
+			kind, ok := node["type"].(string)
+			if !ok {
+				return nil, fail
+			}
+			if schema.ExcludeType != "" {
+				for _, t := range strings.Split(schema.ExcludeType, "|") {
+					if strings.EqualFold(t, kind) {
+						continue LOOP
+					}
+				}
+			}
+			if schema.ExcludeFilter != "" {
+				for _, r := range excludes {
+					m, e := match(r, name)
+					if e != nil {
+						return nil, fail
+					}
+					if m {
+						continue LOOP
+					}
+				}
+			}
+			if schema.Filter != "" {
+				m, e := match(filter, name)
+				if e != nil {
+					return nil, fail
+				}
+				if !m {
+					continue
+				}
+			}
+			if seen[name] {
+				continue
+			}
+			if time.Now().After(deadline) {
+				return nil, fail
+			}
+			if err := schema.Override.Apply(node); err != nil {
+				return nil, fail
+			}
+			seen[name] = true
+			// Freeze each result; native adapters retain the value at this point even if
+			// a later backtick expression matches the newly renamed source mapping.
+			frozen := map[string]any{}
+			for k, v := range node {
+				frozen[k] = v
+			}
+			result = append(result, frozen)
+			if len(result) > 512 {
+				return nil, fail
+			}
+		}
+	}
+	if len(result) == 0 {
+		return nil, fail
+	}
+	return result, nil
+}
