+// MatchNamesForIOS uses the pinned regexp2 engine, including lookaround and
+// backtick expression ordering. A failure/timeout never becomes a silent miss.
+func MatchNamesForIOS(pattern string, names []string) ([][]bool, error) {
+	regs, err := iosPolicyRegex(pattern)
+	if err != nil {
+		return nil, err
+	}
+	if len(names) > 576 {
+		return nil, errors.New("too many names")
+	}
+	deadline := time.Now().Add(2 * time.Second)
+	result := [][]bool{}
+	for _, r := range regs {
+		row := []bool{}
+		for _, name := range names {
+			if len(name) > 1024 || time.Now().After(deadline) {
+				return nil, errors.New("policy budget")
+			}
+			m, e := r.MatchString(name)
+			if e != nil {
+				return nil, errors.New("policy regex")
+			}
+			row = append(row, m)
+		}
+		result = append(result, row)
+	}
+	return result, nil
+}
+func iosPolicyRegex(pattern string) ([]*regexp2.Regexp, error) {
+	parts := strings.Split(pattern, "`")
+	if len(pattern) > 2048 || len(parts) > 16 {
+		return nil, errors.New("policy limit")
+	}
+	result := []*regexp2.Regexp{}
+	for _, part := range parts {
+		r, e := regexp2.Compile(part, regexp2.None)
+		if e != nil {
+			return nil, errors.New("policy regex")
+		}
+		r.MatchTimeout = 10 * time.Millisecond
+		result = append(result, r)
+	}
+	return result, nil
+}
+func ResolveMembersForIOS(options map[string]any, providers []IOSPolicyProvider) ([]string, error) {
+	fail := errors.New("invalid group policy")
+	if len(providers) > 33 {
+		return nil, fail
+	}
+	text := func(key string) (string, error) {
+		v, ok := options[key]
+		if !ok {
+			return "", nil
+		}
+		s, ok := v.(string)
+		if !ok {
+			return "", fail
+		}
+		return s, nil
+	}
+	filter, e := text("filter")
+	if e != nil {
+		return nil, fail
+	}
+	exclude, e := text("exclude-filter")
+	if e != nil {
+		return nil, fail
+	}
+	types, e := text("exclude-type")
+	if e != nil {
+		return nil, fail
+	}
+	names := []string{}
+	pds := []P.ProxyProvider{}
+	for _, p := range providers {
+		pds = append(pds, iosPolicyProvider{data: p})
+		for _, n := range p.Nodes {
+			if _, ok := iosPolicyTypes[n.Type]; !ok {
+				return nil, fail
+			}
+			names = append(names, n.Name)
+		}
+	}
+	if len(names) > 576 {
+		return nil, fail
+	}
+	for _, name := range names {
+		if len(name) > 1024 {
+			return nil, fail
+		}
+	}
+	if _, e = iosPolicyRegex(filter); e != nil {
+		return nil, fail
+	}
+	if _, e = iosPolicyRegex(exclude); e != nil {
+		return nil, fail
+	}
+	gb := NewGroupBase(GroupBaseOption{Name: "IOS", Providers: pds, Filter: filter, ExcludeFilter: exclude, ExcludeType: types})
+	for _, r := range append(gb.filterRegs, gb.excludeFilterRegs...) {
+		r.MatchTimeout = 10 * time.Millisecond
+	}
+	gb.iosPolicyDeadline = time.Now().Add(2 * time.Second)
+	values := gb.GetProxies(false)
+	if gb.iosPolicyError != nil {
+		return nil, fail
+	}
+	result := []string{}
+	for _, v := range values {
+		if v == nil {
+			return nil, fail
+		}
+		result = append(result, v.Name())
+	}
+	if len(result) == 0 {
+		return nil, fail
+	}
+	return result, nil
+}
+
+func (gb *GroupBase) iosPolicyMatch(r *regexp2.Regexp, name string) (bool, error) {
+	if !gb.iosPolicyDeadline.IsZero() && time.Now().After(gb.iosPolicyDeadline) {
+		gb.iosPolicyError = errors.New("policy budget")
+		return false, gb.iosPolicyError
+	}
+	m, e := r.MatchString(name)
+	if !gb.iosPolicyDeadline.IsZero() && e != nil {
+		gb.iosPolicyError = e
+	}
+	return m, e
+}
