+// ResolvePolicyForIOS never opens a service or fetches a resource. Secret-bearing
+// mappings are returned only to the caller; errors deliberately contain no input.
+func ResolvePolicyForIOS(input string) (*StringBox, error) {
+	fail := errors.New("invalid or excessive selection policy")
+	if len(input) > 3*1024*1024 {
+		return nil, fail
+	}
+	var request struct {
+		Operation string                            `json:"operation"`
+		Options   map[string]any                    `json:"options"`
+		Nodes     []map[string]any                  `json:"nodes"`
+		Pattern   string                            `json:"pattern"`
+		Names     []string                          `json:"names"`
+		Providers []outboundgroup.IOSPolicyProvider `json:"providers"`
+	}
+	if json.Unmarshal([]byte(input), &request) != nil {
+		return nil, fail
+	}
+	var result any
+	var err error
+	switch request.Operation {
+	case "provider":
+		result, err = provider.ResolveMappingsForIOS(request.Options, request.Nodes)
+	case "matches":
+		result, err = outboundgroup.MatchNamesForIOS(request.Pattern, request.Names)
+	case "group":
+		result, err = outboundgroup.ResolveMembersForIOS(request.Options, request.Providers)
+	default:
+		return nil, fail
+	}
+	if err != nil {
+		return nil, fail
+	}
+	data, err := json.Marshal(result)
+	if err != nil {
+		return nil, fail
+	}
+	return &StringBox{Value: string(data)}, nil
+}
