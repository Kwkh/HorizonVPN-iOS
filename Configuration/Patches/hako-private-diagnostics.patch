+// Count successful bytes even when Read/Write also returns an error. Capturing
+// the manager keeps an in-flight probe tied to its original statistics owner.
+type urlTestCountingConn struct {
+	net.Conn
+	manager *statistic.Manager
+	outbound string
+}
+
+func (c *urlTestCountingConn) Read(b []byte) (int, error) {
+	n, err := c.Conn.Read(b)
+	if n > 0 { c.manager.PushDownloaded(c.outbound, int64(n)) }
+	return n, err
+}
+
+func (c *urlTestCountingConn) Write(b []byte) (int, error) {
+	n, err := c.Conn.Write(b)
+	if n > 0 { c.manager.PushUploaded(c.outbound, int64(n)) }
+	return n, err
+}
