+// PrivateNodeProbeJSON returns only allowlisted outcomes, never error text,
+// proxy identities, resolved addresses, response headers or bodies.
+// It is opt-in and is never called by tunnel startup.
+func PrivateNodeProbeJSON(name string) string {
+    result := map[string]any{"bootstrap":"unavailable", "https":"not-run", "delay":int32(-1)}
+    if !setupPrivateDiagnostics.Load() { return mustJSON(result) }
+    proxy, ok := tunnel.Proxies()[name]
+    if !ok { proxy, ok = proxyFromProviders(name) }
+    if !ok { return mustJSON(result) }
+    host, _, err := net.SplitHostPort(proxy.Addr())
+    if err != nil { return mustJSON(result) }
+    ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+    ips, err := resolver.LookupIPWithResolver(ctx, host, resolver.ProxyServerHostResolver)
+    cancel()
+    if err != nil { result["bootstrap"] = privateProbeReason(err); return mustJSON(result) }
+    if len(ips) == 0 { result["bootstrap"] = "no-answer"; return mustJSON(result) }
+    result["bootstrap"] = "resolved"
+    ctx, cancel = context.WithTimeout(context.Background(), 5*time.Second)
+    defer cancel()
+    if tester, ok := proxy.(adapter.URLTestOutcomeProvider); ok {
+        outcome, err := tester.URLTestOutcome(ctx, "https://1.1.1.1/cdn-cgi/trace", urlTestExpectedStatus)
+        if err != nil { result["https"] = privateProbeReason(err) } else if !outcome.Satisfied {
+            result["https"] = "http-status"
+        } else { result["https"] = "success"; result["delay"] = int32(outcome.Delay) }
+    }
+    return mustJSON(result)
+}
+
+func privateProbeReason(err error) string {
+    if err == nil { return "success" }
+    text := strings.ToLower(err.Error())
+    for _, pair := range [][2]string{
+        {"certificate", "tls"}, {"tls:", "tls"},
+        {"authentication", "authentication"}, {"auth failed", "authentication"},
+        {"no such host", "dns-name"}, {"network is unreachable", "network"},
+        {"operation not permitted", "permission"}, {"permission denied", "permission"},
+        {"connection refused", "refused"}, {"timeout", "timeout"},
+        {"deadline exceeded", "timeout"},
+    } { if strings.Contains(text, pair[0]) { return pair[1] } }
+    return "failed"
+}
+
+// URLTestWithTimeout keeps URLTest's numeric-only result and 2xx requirement,
+// while allowing native clients to match their desktop measurement deadline.
+func URLTestWithTimeout(name, url string, timeoutMillis int32) int32 {
+	if timeoutMillis < 1 || timeoutMillis > 60000 {
+		return -1
+	}
+	proxy, ok := tunnel.Proxies()[name]
+	if !ok {
+		proxy, ok = proxyFromProviders(name)
+		if !ok {
+			return -1
+		}
+	}
+	return urlTestDelayWithTimeout(proxy, url, timeoutMillis)
+}
+
+func urlTestDelayWithTimeout(proxy C.Proxy, url string, timeoutMillis int32) int32 {
+	if timeoutMillis < 1 || timeoutMillis > 60000 {
+		return -1
+	}
+	if url == "" {
+		url = defaultURLTestURL
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Duration(timeoutMillis)*time.Millisecond)
+	defer cancel()
+	if outcomes, ok := proxy.(adapter.URLTestOutcomeProvider); ok {
+		result, err := outcomes.URLTestOutcome(ctx, url, urlTestExpectedStatus)
+		if err != nil || !result.Satisfied || ctx.Err() != nil {
+			return -1
+		}
+		return int32(result.Delay)
+	}
+	delay, err := proxy.URLTest(ctx, url, urlTestExpectedStatus)
+	if err != nil || ctx.Err() != nil {
+		return -1
+	}
+	return int32(delay)
+}
+
+// CancellableURLTests scopes native requests to one user initiated batch.
+// Numeric results only: -1 failed, -2 cancelled, -3 timed out.
+// Shared admission prevents cancelled/restarted batches from exceeding 5 dials.
+var privateBatchSlots = make(chan struct{}, 5)
+
+type CancellableURLTests struct {
+    ctx context.Context
+    cancel context.CancelFunc
+}
+
+func NewCancellableURLTests(concurrency int) *CancellableURLTests {
+    if concurrency != 5 { return nil }
+    ctx, cancel := context.WithCancel(context.Background())
+    return &CancellableURLTests{ctx: ctx, cancel: cancel}
+}
+
+func (b *CancellableURLTests) Cancel() { b.cancel() }
+
+func (b *CancellableURLTests) Test(name, url string, timeoutMillis int32) int32 {
+    if timeoutMillis < 1 || timeoutMillis > 10000 { return -1 }
+    select {
+    case <-b.ctx.Done(): return -2
+    case privateBatchSlots <- struct{}{}:
+    }
+    defer func() { <-privateBatchSlots }()
+    if b.ctx.Err() != nil { return -2 }
+    proxy, ok := tunnel.Proxies()[name]
+    if !ok { proxy, ok = proxyFromProviders(name) }
+    if !ok { return -1 }
+    ctx, cancel := context.WithTimeout(b.ctx, time.Duration(timeoutMillis)*time.Millisecond)
+    defer cancel()
+    tester, ok := proxy.(adapter.URLTestOutcomeProvider)
+    if !ok { return -1 }
+    outcome, err := tester.URLTestOutcome(ctx, url, urlTestExpectedStatus)
+    if b.ctx.Err() != nil { return -2 }
+    if ctx.Err() == context.DeadlineExceeded { return -3 }
+    if err != nil || ctx.Err() != nil || !outcome.Satisfied || outcome.Delay == 0 { return -1 }
+    return int32(outcome.Delay)
+}
